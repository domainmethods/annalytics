    {
      "corpusId": "seed-007",
      "question": "Find any anomalies in daily signup counts over the past 90 days",
      "generatedSql": "WITH daily_signups AS (\n    SELECT\n        event_date_dt,\n        COUNT(*) AS signup_count\n    FROM\n        `analytics.stg_ga4__event_sign_up`\n    WHERE\n        event_date_dt >= DATE_SUB(CURRENT_DATE(), INTERVAL 179 DAY)\n    GROUP BY\n        event_date_dt\n),\nmoving_metrics AS (\n    SELECT\n        event_date_dt,\n        signup_count,\n        AVG(signup_count) OVER (\n            ORDER BY event_date_dt \n            ROWS BETWEEN 89 PRECEDING AND CURRENT ROW\n        ) AS moving_avg_90d,\n        STDDEV(signup_count) OVER (\n            ORDER BY event_date_dt \n            ROWS BETWEEN 89 PRECEDING AND CURRENT ROW\n        ) AS moving_stddev_90d\n    FROM\n        daily_signups\n)\nSELECT\n    event_date_dt,\n    signup_count,\n    moving_avg_90d,\n    moving_stddev_90d,\n    CASE \n        WHEN ABS(signup_count - moving_avg_90d) > (2 * moving_stddev_90d) THEN TRUE \n        ELSE FALSE \n    END AS is_anomaly\nFROM\n    moving_metrics\nWHERE\n    event_date_dt >= DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY)\nORDER BY\n    event_date_dt DESC;",
