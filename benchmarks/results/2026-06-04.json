    {
      "corpusId": "seed-005",
      "question": "Compare conversion rates between mobile and desktop by funnel stage",
      "generatedSql": "WITH funnel_events AS (\n  SELECT session_key, 'Landing' AS stage FROM `analytics.stg_ga4__event_page_view`\n  UNION ALL\n  SELECT session_key, 'View Item' AS stage FROM `analytics.stg_ga4__event_view_item`\n  UNION ALL\n  SELECT session_key, 'Add to Cart' AS stage FROM `analytics.stg_ga4__event_add_to_cart`\n  UNION ALL\n  SELECT session_key, 'Purchase' AS stage FROM `analytics.stg_ga4__event_purchase`\n),\nsession_flags AS (\n  SELECT\n    session_key,\n    MAX(IF(stage = 'Landing', 1, 0)) AS has_landing,\n    MAX(IF(stage = 'View Item', 1, 0)) AS has_view_item,\n    MAX(IF(stage = 'Add to Cart', 1, 0)) AS has_add_to_cart,\n    MAX(IF(stage = 'Purchase', 1, 0)) AS has_purchase\n  FROM funnel_events\n  GROUP BY session_key\n)\nSELECT\n  s.device_category,\n  COUNT(s.session_key) AS total_sessions,\n  COALESCE(SUM(f.has_landing), 0) AS landing_sessions,\n  COALESCE(SUM(f.has_view_item), 0) AS view_item_sessions,\n  COALESCE(SUM(f.has_add_to_cart), 0) AS add_to_cart_sessions,\n  COALESCE(SUM(f.has_purchase), 0) AS purchase_sessions,\n  SAFE_DIVIDE(SUM(f.has_landing), COUNT(s.session_key)) AS pct_landing_sessions,\n  SAFE_DIVIDE(SUM(f.has_view_item), COUNT(s.session_key)) AS pct_view_item_sessions,\n  SAFE_DIVIDE(SUM(f.has_add_to_cart), COUNT(s.session_key)) AS pct_add_to_cart_sessions,\n  SAFE_DIVIDE(SUM(f.has_purchase), COUNT(s.session_key)) AS pct_purchase_sessions\nFROM `analytics.dim_ga4__sessions` s\nLEFT JOIN session_flags f \n  ON s.session_key = f.session_key\nGROUP BY s.device_category;",
