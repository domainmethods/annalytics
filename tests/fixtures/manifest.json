        "name": { "name": "name", "description": "", "meta": {} },
        "email": { "name": "email", "description": "", "meta": {} },
        "region": { "name": "region", "description": "Geographic region", "meta": {} },
        "last_order_date": { "name": "last_order_date", "description": "", "meta": {} }
