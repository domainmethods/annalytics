# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Gemini (Developer API key — required for File Search)
# Only Gemini 3.x models are supported. These pin the residual non-node consumers
# (judge + config) to 3.x; per-node generation resolves via nodeProfiles (below).
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview

# Per-node model sizing (optional). JSON keyed by nodeId; deep-merged over the
# Gemini 3.x defaults. Invalid/unresolvable entries are ignored (warn-once) and
# fall back to the node default. thinkingLevel is discrete: minimal|low|medium|high.
#
# The example below is the MEASURED clarification downsize from the 2026-06-08 live
# sweep (benchmarks/results/node-sweep-2026-06-08.md): the clarification metric was
# byte-identical across the whole ladder (ε=0.01), so flash-lite/3.1 matches flash/3
# quality at ~3.4x lower p95 latency and ~3x lower cost. It is kept here as a
# recommended override rather than a template hard-default because clarification is
# borderline install-tuned (what "needs clarifying" depends on the installed schema)
# and the 12-question corpus exercises few clarification cases — re-measure on a
# domain corpus before adopting it install-wide.
# NODE_PROFILE_OVERRIDES={"clarification":{"tier":"flash-lite","version":"3.1","thinkingLevel":"minimal"}}
# Escape hatch to remap a (tier/version) pair to an exact published model id:
# MODEL_ID_OVERRIDES={"pro/3.1":"gemini-3.1-pro-001"}

# GCP (ADC for BigQuery + Firestore — service account on Cloud Run)
GCP_PROJECT_ID=...

# dbt artifacts (COPY'd into container at build time)
DBT_MANIFEST_PATH=./dbt/manifest.json
DBT_CATALOG_PATH=./dbt/catalog.json

# dbt run results webhook (optional — enables POST /api/dbt-run-results)
DBT_WEBHOOK_SECRET=

# Lifecycle sweep (optional — enables POST /api/lifecycle-sweep so a scheduler
# can drive escalation reminders/timeouts on wall-clock time)
# LIFECYCLE_SWEEP_SECRET=

# App config
PORT=3000
COST_GATE_MAX_BYTES=10737418240  # 10GB
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=1000
RATE_LIMIT_PER_HOUR=30
LOG_LEVEL=info

# Routine fast path (disabled by default). This path keeps deterministic SQL
# validation and can skip supervisor only for well-grounded low-risk queries.
FAST_PATH_ENABLED=false
FAST_PATH_MAX_BYTES=1073741824
# true = pilot mode: eligible fast-path candidates still run supervisor.
# false = skip supervisor when no risk triggers fire.
FAST_PATH_REQUIRE_SUPERVISOR=true

# Gemini File Search store for ReferenceCards and teachings
FILE_SEARCH_STORE_ID=

# Escalation (human-in-the-loop). mode=channel posts to ESCALATION_CHANNEL_ID;
# mode=dm DMs ESCALATION_ANALYST_USER_ID. Escalation is skipped if no target resolves.
ESCALATION_MODE=channel
ESCALATION_CHANNEL_ID=
ESCALATION_ANALYST_USER_ID=
ESCALATION_REMINDER_MINUTES=30
ESCALATION_TIMEOUT_HOURS=4
# Route the negative-feedback "wrong number" / "wrong data" path to the analyst (default true).
ESCALATION_ON_NEGATIVE_FEEDBACK=true
