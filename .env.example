# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Gemini (Developer API key — required for File Search)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-pro-latest
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_JUDGE_MODEL=gemini-pro-latest

# GCP (ADC for BigQuery + Firestore — service account on Cloud Run)
GCP_PROJECT_ID=...

# dbt artifacts (COPY'd into container at build time)
DBT_MANIFEST_PATH=./dbt/manifest.json
DBT_CATALOG_PATH=./dbt/catalog.json

# dbt run results webhook (optional — enables POST /api/dbt-run-results)
DBT_WEBHOOK_SECRET=

# App config
PORT=3000
COST_GATE_MAX_BYTES=10737418240  # 10GB
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=1000
RATE_LIMIT_PER_HOUR=30
LOG_LEVEL=info

# Gemini File Search store for ReferenceCards and teachings
FILE_SEARCH_STORE_ID=

# Escalation (human-in-the-loop). mode=channel posts to ESCALATION_CHANNEL_ID;
# mode=dm DMs ESCALATION_ANALYST_USER_ID. Escalation is skipped if no target resolves.
ESCALATION_MODE=channel
ESCALATION_CHANNEL_ID=
ESCALATION_ANALYST_USER_ID=
ESCALATION_REMINDER_MINUTES=30
ESCALATION_TIMEOUT_HOURS=4
# Route the negative-feedback "wrong number" / "wrong data" path to the analyst (default true).
ESCALATION_ON_NEGATIVE_FEEDBACK=true
