# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Gemini (Developer API key — required for File Search)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-pro-latest
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_JUDGE_MODEL=gemini-pro-latest

# GCP (ADC for BigQuery + Firestore — service account on Cloud Run)
GCP_PROJECT_ID=...

# dbt artifacts (COPY'd into container at build time)
DBT_MANIFEST_PATH=./dbt/manifest.json
DBT_CATALOG_PATH=./dbt/catalog.json

# dbt run results webhook (optional — enables POST /api/dbt-run-results)
DBT_WEBHOOK_SECRET=

# App config
PORT=3000
COST_GATE_MAX_BYTES=10737418240  # 10GB
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=1000
RATE_LIMIT_PER_HOUR=30

# Gemini File Search store for teachings
FILE_SEARCH_STORE_ID=
