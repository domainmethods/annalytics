{
  "name": "annalytics",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx src/app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "knowledge:validate": "tsx scripts/validate-knowledge.ts",
    "knowledge:sync": "tsx scripts/sync-knowledge.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "infra:validate": "sh -c 'cd infra && if command -v terraform >/dev/null 2>&1; then terraform fmt -check && terraform init -backend=false && terraform validate; elif command -v tofu >/dev/null 2>&1; then tofu fmt -check && tofu init -backend=false && tofu validate; else echo \"Terraform/OpenTofu not installed; skipping infra validation\"; fi'",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint --fix src/ tests/ scripts/",
    "promote": "tsx scripts/promote-teachings.ts",
    "node-sweep": "tsx scripts/node-sweep.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/firestore": "^8.3.0",
    "@google/genai": "^1.41.0",
    "@resvg/resvg-js": "^2.6.2",
    "@slack/bolt": "^4.6.0",
    "node-sql-parser": "^5.4.0",
    "pino": "^10.3.1",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}
